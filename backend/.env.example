# HR Search Application Configuration
# Portfolio project — no auth, no CI/CD. Copy this file to .env and adjust.
# Only the keys listed in app/config.py's Settings are read; anything else is ignored.

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string (pgvector + pg_trgm extensions required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5431/hr_search

# asyncpg connection pool sizing
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# =============================================================================
# API / CORS
# =============================================================================
# Comma-separated list of allowed origins for the frontend.
# Supports localhost plus LAN IPs for local development.
CORS_ALLOW_ORIGINS=http://localhost:5173

# =============================================================================
# DOMAIN
# =============================================================================
# Title shown in the frontend header and /api/config response.
DOMAIN_TITLE=HR Knowledge Search

# =============================================================================
# MACHINE LEARNING
# =============================================================================
# HuggingFace sentence-transformer model (multilingual, Polish + English).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Model cache directory (downloads ~500MB on first run).
HF_HOME=./.models_cache

# Batch size for bulk embedding generation (scripts/maintenance/generate_embeddings.py).
EMBEDDING_BATCH_SIZE=32

# =============================================================================
# SEARCH THRESHOLDS (0.0 to 1.0)
# =============================================================================
# pgvector cosine-similarity floor for semantic matches.
SEMANTIC_THRESHOLD=0.3

# pg_trgm similarity floor for the fuzzy fallback.
FUZZY_THRESHOLD=0.2

# word_similarity above which a query auto-routes to the matching entity
# (speaker, tag, or category) instead of semantic search. Checks all three,
# picks the best match. 0.5 = near-exact matches; 0.3 = partial/prefix.
ENTITY_MATCH_THRESHOLD=0.5

# Hard caps for API responses. Defaults live in app/config.py.
# MAX_SEARCH_RESULTS=50
# MAX_AUTOCOMPLETE_RESULTS=10

# =============================================================================
# LOGGING
# =============================================================================
# DEBUG, INFO, WARNING, ERROR, CRITICAL. Log file path is hardcoded to logs/hr_search.log.
LOG_LEVEL=INFO
