# HR Search Application Configuration
# Copy this file to .env and modify values as needed

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql://hrsearch:hrsearch@localhost:5432/hrsearch

# Database connection pool settings
DATABASE__POOL_MIN_SIZE=5
DATABASE__POOL_MAX_SIZE=20
DATABASE__COMMAND_TIMEOUT=10
DATABASE__STATEMENT_CACHE_SIZE=100
DATABASE__MAX_QUERIES=50000
DATABASE__MAX_INACTIVE_CONNECTION_LIFETIME=300.0

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================
# Server host and port
API__HOST=0.0.0.0
API__PORT=8000
API__TITLE=HR Search API
API__VERSION=1.0.0
API__DEBUG=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Secret key for JWT tokens (generate a secure random string)
SECURITY__SECRET_KEY=your-secret-key-here-minimum-32-characters-long
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS settings (comma-separated values)
SECURITY__CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
SECURITY__CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
SECURITY__CORS_ALLOW_HEADERS=*
SECURITY__CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# MACHINE LEARNING CONFIGURATION
# =============================================================================
# HuggingFace model for embeddings
ML__EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# HuggingFace cache directory
ML__HF_HOME=./.models_cache

# Embedding generation settings
ML__EMBEDDING_BATCH_SIZE=32
ML__EMBEDDING_DIMENSIONS=384
ML__USE_MODEL_QUANTIZATION=false

# Search thresholds (0.0 to 1.0)
ML__SEMANTIC_THRESHOLD=0.3
ML__FUZZY_THRESHOLD=0.2

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOGGING__LEVEL=INFO

# Log file path (empty for console only)
LOGGING__FILE=

# Log format: structured, simple, json
LOGGING__FORMAT=structured

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Cache settings
CACHE__DEFAULT_TTL=300
CACHE__MAX_SIZE=1000

# Redis URL for distributed caching (optional)
# CACHE__REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SEARCH CONFIGURATION
# =============================================================================
# Search limits
SEARCH__MAX_QUERY_LENGTH=200
SEARCH__MAX_RESULTS_LIMIT=50
SEARCH__DEFAULT_RESULTS_LIMIT=20

# =============================================================================
# ENVIRONMENT-SPECIFIC CONFIGURATIONS
# =============================================================================

# Development Environment
# Uncomment and modify for development
# DATABASE_URL=postgresql://hrsearch:hrsearch@localhost:5432/hrsearch_dev
# API__DEBUG=true
# LOGGING__LEVEL=DEBUG
# ML__USE_MODEL_QUANTIZATION=false

# Staging Environment
# Uncomment and modify for staging
# DATABASE_URL=postgresql://hrsearch:hrsearch@staging-db:5432/hrsearch_staging
# API__DEBUG=false
# LOGGING__LEVEL=INFO
# ML__USE_MODEL_QUANTIZATION=true

# Production Environment
# Uncomment and modify for production
# DATABASE_URL=postgresql://hrsearch:hrsearch@prod-db:5432/hrsearch_prod
# API__DEBUG=false
# LOGGING__LEVEL=WARNING
# ML__USE_MODEL_QUANTIZATION=true
# SECURITY__SECRET_KEY=your-production-secret-key-here
# LOGGING__FILE=/var/log/hrsearch/app.log

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Never commit the actual .env file to version control
# 2. Use strong, unique secret keys in production
# 3. Restrict CORS origins to your actual frontend domains
# 4. Use environment-specific database credentials
# 5. Consider using a secrets management service for production

# =============================================================================
# PERFORMANCE TUNING NOTES
# =============================================================================
# Database Pool:
# - Increase POOL_MAX_SIZE for high-traffic applications
# - Adjust COMMAND_TIMEOUT based on query complexity
# - Monitor connection usage and adjust accordingly

# ML Model:
# - Enable USE_MODEL_QUANTIZATION for faster inference
# - Adjust EMBEDDING_BATCH_SIZE based on available memory
# - Use smaller models for faster startup if accuracy allows

# Cache:
# - Increase DEFAULT_TTL for stable content
# - Use Redis for distributed caching in multi-instance deployments
# - Monitor cache hit rates and adjust TTL accordingly

# Search:
# - Adjust SEMANTIC_THRESHOLD based on result quality requirements
# - Lower FUZZY_THRESHOLD for more permissive fuzzy matching
# - Increase MAX_RESULTS_LIMIT for applications needing more results